# hpc/config/cluster.env — site and project settings, sourced (set -a) by every job and by submit.py.
# submit.py freezes a copy into hpc/logs/<RUN_ID>/config/ so later edits never change a running study.

# ── Slurm ────────────────────────────────────────────────────────────────────
ACCOUNT="${ACCOUNT:-def-mbabaei_gpu}"         # the only GPU account (sshare -U -u mbabaei)
MAIL_TYPE="${MAIL_TYPE:-FAIL}"
MAX_REQUEUES="${MAX_REQUEUES:-20}"
REQUEUE_SIGNAL_SECS=900

# ── Software (Alliance modules + wheelhouse) ─────────────────────────────────
MODULES="StdEnv/2023 python/3.11"             # datasets are shipped as JSONL: no pyarrow needed
EXTRA_WHEELS="${EXTRA_WHEELS:-}"
SRC_DIRS="src ."                              # heartness package + experiments/ package
CODE_HASH_DIRS="src experiments scripts"

# ── Storage (per cluster; Alliance sets CC_CLUSTER on login and compute nodes) ─
PROJECT_NAME="heartness"
case "${CC_CLUSTER:-}" in
  narval|rorqual)  # compute nodes have no internet: Ollama + models are staged from the login node
    WORK="${WORK:-/scratch/mbabaei/heartness-work}"
    OFFLINE=1 ;;
  fir)     # compute nodes reach the internet but are throttled (~55 KB/s measured): stage from login
    WORK="${WORK:-/scratch/mbabaei/heartness-work}"
    OFFLINE=1 ;;
  *)       # nibi: compute nodes have internet; /scratch is at ~88% of quota -> /project
    WORK="${WORK:-/project/def-mbabaei/mbabaei/heartness-work}"
    OFFLINE=0 ;;
esac
RESULTS_DEST=""

# ── Inference service (hooks/gen.sh, hooks/oracle.sh, scripts/hpc/setup_nibi.sh) ─
OLLAMA_VERSION="v0.32.14"
OLLAMA_PREFIX="$WORK/ollama"
OLLAMA_MODELS="$WORK/ollama-models"
HEARTNESS_DATA="${REPO_DIR:-$(pwd)}/build/data"   # shipped JSONL datasets inside the synced repo

# ── GPU policy ───────────────────────────────────────────────────────────────
GPU_MONITOR_SECS=60
